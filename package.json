{
  "name": "muse-commerce-audit",
  "version": "0.1.0",
  "description": "Chromium auditor: can an AI shopping agent (Meta Muse) read and act on your shop?",
  "license": "MIT",
  "type": "module",
  "bin": {
    "muse-commerce-audit": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "audit": "node dist/src/cli.js",
    "test": "tsc && node --test --test-timeout=120000 \"dist/test/**/*.test.js\"",
    "screenshots": "tsc && node dist/test/screenshots.js"
  },
  "dependencies": {
    "@muse-code/sdk": "1.3.0",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arananet/muse-sdk-agentic-commerce.git"
  },
  "author": "Eduardo Arana"
}
